[Unit]
Description=Run the ERP-AI-Pro retention sweeps once a day
Documentation=https://github.com/Dewiride-Open-Source/ERP-AI-Pro/blob/main/docs/operations/runbooks/host-setup.md

[Timer]
OnCalendar=*-*-* 01:00:00 Asia/Kolkata
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
