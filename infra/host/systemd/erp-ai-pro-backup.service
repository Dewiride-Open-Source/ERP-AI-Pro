[Unit]
Description=Back up the ERP-AI-Pro server's own files to Azure Blob Storage
Documentation=https://github.com/Dewiride-Open-Source/ERP-AI-Pro/blob/main/docs/operations/runbooks/host-setup.md
Wants=docker.service network-online.target
After=docker.service network-online.target erp-ai-pro.service
ConditionPathExists=/srv/erp-ai-pro/ERP-AI-Pro/infra/compose/.env
ConditionPathExists=/srv/erp-ai-pro/ERP-AI-Pro/infra/compose/secrets/erp-backup-client.pem
ConditionPathExists=/srv/erp-ai-pro/ERP-AI-Pro/infra/compose/secrets/erp-backup-recipient.crt

[Service]
Type=oneshot
User=erp-ai-pro
Group=erp-ai-pro
WorkingDirectory=/srv/erp-ai-pro/ERP-AI-Pro/infra/compose
# The plaintext copy is staged under /run, a tmpfs, in a folder systemd creates for the deploy account and removes when the
# run ends.
RuntimeDirectory=erp-ai-pro-backup
RuntimeDirectoryMode=0700
UMask=0077
# backup.sh waits for the deployment lock itself, at most 14 minutes, so the rest of TimeoutStartSec is left for the upload.
ExecStart=/usr/bin/bash /srv/erp-ai-pro/ERP-AI-Pro/scripts/deploy/backup.sh
TimeoutStartSec=30min
