{
  "Erp": {
    "Platform": {
      "Host": {
        "ApplicationName": "ERP-AI-Pro",
        "AllowedHosts": "*",
        "MaxRequestBodyBytes": "1048576",
        "RequestTimeout": "00:00:30"
      },
      "RateLimiting": {
        "Enabled": "true",
        "AnonymousPermitLimit": "600",
        "AnonymousWindow": "00:01:00",
        "ActorPermitLimit": "600",
        "ActorWindow": "00:01:00",
        "ActorSegmentsPerWindow": "6"
      },
      "Caching": {
        "DefaultExpiration": "00:05:00",
        "MaximumPayloadBytes": "1048576"
      },
      "Identity": {
        "Instance": "https://login.microsoftonline.com/"
      },
      "Database": {
        "Provider": "SqlServer",
        "CommandTimeout": "00:00:30",
        "MaxRetryCount": "5",
        "MaxRetryDelay": "00:00:10"
      },
      "Idempotency": {
        "RetentionPeriod": "1.00:00:00",
        "MaxStoredResponseBytes": "1048576",
        "CleanupInterval": "01:00:00"
      }
    }
  }
}
