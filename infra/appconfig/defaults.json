{
  "Erp": {
    "Platform": {
      "Host": {
        "ApplicationName": "ERP-AI-Pro",
        "AllowedHosts": "*",
        "MaxRequestBodyBytes": "1048576",
        "RequestTimeout": "00:00:30"
      },
      "RateLimiting": {
        "Enabled": "true",
        "AnonymousPermitLimit": "600",
        "AnonymousWindow": "00:01:00",
        "ActorPermitLimit": "600",
        "ActorWindow": "00:01:00",
        "ActorSegmentsPerWindow": "6",
        "SignInPermitLimit": "60",
        "SignInWindow": "00:01:00"
      },
      "Caching": {
        "DefaultExpiration": "00:05:00",
        "MaximumPayloadBytes": "1048576"
      },
      "Identity": {
        "Instance": "https://login.microsoftonline.com/",
        "SessionIdleTimeout": "00:30:00",
        "SessionLifetime": "12:00:00"
      },
      "Database": {
        "Provider": "SqlServer",
        "CommandTimeout": "00:00:30",
        "MaxRetryCount": "5",
        "MaxRetryDelay": "00:00:10"
      },
      "Idempotency": {
        "RetentionPeriod": "1.00:00:00",
        "MaxStoredResponseBytes": "1048576",
        "CleanupInterval": "01:00:00"
      },
      "Auditing": {
        "SecurityEventRetention": "365.00:00:00",
        "SweepInterval": "1.00:00:00"
      },
      "Attachments": {
        "MaxSizeBytes": "26214400",
        "AllowedContentTypes": "application/pdf;image/png;image/jpeg;image/gif;image/webp;text/plain;text/csv;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "DownloadLinkLifetime": "00:05:00",
        "TransferTimeout": "00:10:00"
      }
    }
  }
}
