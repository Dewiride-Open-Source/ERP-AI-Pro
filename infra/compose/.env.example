# Image tag pulled from ghcr.io (a release tag in production, "local" for locally built images)
IMAGE_TAG=local

# Subnet of the compose network; the API trusts forwarded headers only from this range
COMPOSE_NETWORK_CIDR=172.28.0.0/16

# Azure App Configuration endpoint (https://<store>.azconfig.io) for the production stack, which refuses to start without it.
# Leave it empty on a developer machine: the local stack cannot sign in to Azure and runs on appsettings (dotnet run uses user secrets instead)
APPCONFIG_ENDPOINT=

# Production only: Entra tenant id the api container signs in to (an id, not a secret)
AZURE_TENANT_ID=

# Production only: application (client) id of the runtime service principal (an id, not a secret)
AZURE_CLIENT_ID=

# Production only: application (client) id of the migrator service principal, the separate identity whose database user
# may change the schema (an id, not a secret); its certificate is the secret file secrets/erp-migrator-client.pem
MIGRATOR_AZURE_CLIENT_ID=

# Local development only: the api container reads its database connection from the git-ignored file
# infra/compose/secrets/Erp__Platform__Database__ConnectionString (a compose secret mounted under /run/secrets), one line of the shape
#   Server=host.docker.internal,1433;Database=ErpAiPro;User ID=<login>;Password=<password>;Encrypt=True;TrustServerCertificate=True
# because a container cannot use Windows sign-in. The stack refuses to start without the file;
# docs/guides/local-development.md lists the SQL Server steps (TCP/IP, mixed-mode sign-in, the SQL login and its database roles).
# The migrator container reads infra/compose/secrets/Erp__Platform__Database__MigratorConnectionString, the same shape for a
# second SQL login that may also change the schema (db_ddladmin); the api container keeps the data-only login.

# Local development only: the api container keeps attachments in the stack's azurite service (the Blob Storage emulator) and
# reads their encryption key from the git-ignored file infra/compose/secrets/Erp__Platform__Attachments__EncryptionKey, one line
# of the shape <key id>:<32 random bytes in base64>. Generate it without displaying it, from the repository root in Git Bash:
#   printf 'local:%s' "$(openssl rand -base64 32)" > infra/compose/secrets/Erp__Platform__Attachments__EncryptionKey
# The stack refuses to start without the file, and attachments stored under one key cannot be read with another.

# Local development only: the local stack cannot sign in to Azure, so the api container gets throwaway sign-in values that
# can never complete a Microsoft sign-in (sign in through dotnet run and pnpm dev, which read every sign-in setting from the
# App Configuration store): placeholder tenant and client ids and the stack's own web origin, http://localhost:3000, set in
# compose.override.yaml, and a self-signed certificate in the git-ignored file
# infra/compose/secrets/Erp__Platform__Identity__ClientCertificate, one line holding a passwordless PKCS#12 in base64 that no
# app registration knows. Generate it from the repository root in Git Bash (MSYS2_ARG_CONV_EXCL stops Git Bash from turning
# the certificate subject into a Windows path):
#   signin="$(mktemp -d)"
#   MSYS2_ARG_CONV_EXCL='/CN=' openssl req -x509 -newkey rsa:2048 -noenc -days 365 -subj "/CN=erp-compose-local" -keyout "$signin/key.pem" -out "$signin/certificate.pem"
#   openssl pkcs12 -export -inkey "$signin/key.pem" -in "$signin/certificate.pem" -passout pass: -out "$signin/certificate.pfx"
#   base64 -w 0 "$signin/certificate.pfx" > infra/compose/secrets/Erp__Platform__Identity__ClientCertificate
#   rm -rf -- "$signin"
# The stack refuses to start without the file, and the api refuses a certificate outside its validity, so run the commands again
# after a year.

# Local development only: send telemetry to the Aspire dashboard (profile "observability").
# The API exports over gRPC, the web app over OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
# WEB_OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18890
