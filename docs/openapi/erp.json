    "/api/platform/features": {
      "get": {
        "tags": [
          "Platform.Features"
        ],
        "summary": "Returns every feature flag of the catalog with its evaluated state.",
        "operationId": "Platform.Features.List",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeaturesResponse"
                }
              }
            }
          }
        }
      }
