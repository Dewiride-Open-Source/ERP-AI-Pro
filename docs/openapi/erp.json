  "components": {
    "schemas": {
      "AttachmentResponse": {
        "required": [
          "id",
          "fileName",
          "contentType",
          "sizeBytes",
          "sha256",
          "scanStatus",
          "createdAt",
          "createdBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string"
          },
          "scanStatus": {
            "$ref": "#/components/schemas/AttachmentScanStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AttachmentScanStatus": {
        "enum": [
          "notScanned",
          "clean"
        ]
      },
      "DownloadLinkResponse": {
        "required": [
          "url",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FeaturesResponse": {
        "required": [
          "features"
        ],
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeatureStateResponse"
            }
          }
        }
      },
      "FeatureStateResponse": {
        "required": [
          "name",
          "enabled"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "x-ms-primary-error-message": true
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code; the type member is this code under /problems/."
          },
          "traceId": {
            "type": "string",
            "description": "Correlation id of the request, the same value the X-Correlation-ID response header carries."
          }
        }
      },
      "PagedResponseOfAttachmentResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "x-ms-primary-error-message": true
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code; the type member is this code under /problems/."
          },
          "traceId": {
            "type": "string",
            "description": "Correlation id of the request, the same value the X-Correlation-ID response header carries."
          }
        }
      },
      "RecentStartupsResponse": {
        "required": [
          "startups"
        ],
        "type": "object",
        "properties": {
          "startups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StartupResponse"
            }
          }
        }
      },
      "StartupResponse": {
        "required": [
          "id",
          "applicationName",
          "version",
          "framework",
          "environmentName",
