    "/api/platform/attachments/{id}/download-links": {
      "post": {
        "tags": [
          "Platform.Attachments"
        ],
        "summary": "Creates a short-lived link that downloads the attachment for the person asking.",
        "operationId": "Platform.Attachments.CreateDownloadLink",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
