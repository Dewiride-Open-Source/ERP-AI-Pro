{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dewiride:erp-ai-pro:roadmap:v1",
  "title": "ERP-AI-Pro roadmap",
  "description": "Single source of truth for the delivery roadmap. Ids are stable slugs; positional labels (P07, P07.3) are derived at render time. Mutate only through scripts/roadmap/roadmap.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "updatedOn", "milestones", "phases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updatedOn": { "$ref": "#/$defs/date" },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/milestone" }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "enum": ["planned", "in-progress", "blocked", "deferred", "done"] },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "milestone", "dependsOn", "subPhases"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "milestone": { "$ref": "#/$defs/slug" },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "deferred": { "const": true },
        "subPhases": { "type": "array", "items": { "$ref": "#/$defs/subPhase" } }
      }
    },
    "subPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scope", "status", "acceptance", "tags", "dependsOn"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "acceptance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "startedOn": { "$ref": "#/$defs/date" },
        "completedOn": { "$ref": "#/$defs/date" },
        "blockedReason": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
