# Entra tenant that owns every ERP-AI-Pro resource and registration
ERP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Subscription that holds the resource group
ERP_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Azure region of the resource group, the store, the three vaults, the four storage accounts and the production database
ERP_AZURE_LOCATION=centralindia

# Resource group created and converged by provision.sh
ERP_AZURE_RESOURCE_GROUP=rg-erp-ai-pro

# App Configuration store name; the endpoint becomes https://<name>.azconfig.io
ERP_AZURE_APPCONFIG_NAME=appcs-erp-ai-pro

# Key Vault behind the local-dev label
ERP_AZURE_KEYVAULT_DEV_NAME=kv-erp-ai-pro-dev

# Key Vault behind the production label
ERP_AZURE_KEYVAULT_PROD_NAME=kv-erp-ai-pro-prod

# Key Vault holding the client certificates of the runtime, migrator and backup service principals and the backup encryption certificate, which only the operator reads
ERP_AZURE_KEYVAULT_OPS_NAME=kv-erp-ai-pro-ops

# Storage account holding the attachments of the local-dev label; globally unique, 3-24 lowercase letters or digits; the blob endpoint becomes https://<name>.blob.core.windows.net/
ERP_AZURE_STORAGE_DEV_NAME=sterpaiprodev

# Storage account holding the attachments of the production label, reachable from the home's public address alone; globally unique, 3-24 lowercase letters or digits
ERP_AZURE_STORAGE_PROD_NAME=sterpaiproprod

# Storage account holding nothing but the server's nightly backups, write-once for 90 days, and the server's journal, write-once for 365 days; reachable from the home's public address alone; globally unique, 3-24 lowercase letters or digits
ERP_AZURE_STORAGE_BACKUP_NAME=sterpaiprobackup

# Storage account holding the records of the Azure resources, the subscription and Microsoft Entra ID, one copy in Central India, write-once for 365 days; reachable from the home's public address and trusted Microsoft services alone; globally unique, 3-24 lowercase letters or digits
ERP_AZURE_STORAGE_LOGS_NAME=sterpaiprologs

# App Configuration tier: Free, Developer, Standard or Premium (Free by owner decision)
ERP_AZURE_APPCONFIG_SKU=Free

# Entra security group (display name or object id) that reads the store and the development vault and writes blobs in the development attachments container; empty skips the developer role assignments
ERP_AZURE_DEVELOPERS_GROUP=

# Public origin of the deployed web app, for example https://erp.example.com; empty until the host name exists
ERP_AZURE_PRODUCTION_WEB_ORIGIN=

# Origin of the web app on a developer machine
ERP_AZURE_LOCAL_WEB_ORIGIN=http://localhost:3000

# Display name of the sign-in app registration used by developer machines
ERP_AZURE_APP_WEB_LOCAL_DEV_NAME="ERP-AI-Pro Web (local-dev)"

# Display name of the sign-in app registration used by the deployed web app
ERP_AZURE_APP_WEB_PRODUCTION_NAME="ERP-AI-Pro Web (production)"

# Display name of the app registration whose service principal the API container runs as; also the name of its database user
ERP_AZURE_APP_RUNTIME_NAME="ERP-AI-Pro Runtime (production)"

# Display name of the app registration whose service principal the migrator container runs as; also the name of its database user
ERP_AZURE_APP_MIGRATOR_NAME="ERP-AI-Pro Migrator (production)"

# Display name of the app registration whose service principal the server's nightly backup and its restore run as
ERP_AZURE_APP_BACKUP_NAME="ERP-AI-Pro Backup (production)"

# Azure SQL logical server of the production database; globally unique, 1-63 lowercase letters, digits or hyphens
ERP_AZURE_SQL_SERVER_NAME=sql-erp-ai-pro

# Production database on that server; letters, digits or underscores
ERP_AZURE_SQL_DATABASE_NAME=ErpAiPro

# Path of the Go sqlcmd when the sqlcmd on PATH is the ODBC one that SQL Server installs; empty looks on PATH, then in C:\Program Files\SqlCmd
ERP_AZURE_SQLCMD=
