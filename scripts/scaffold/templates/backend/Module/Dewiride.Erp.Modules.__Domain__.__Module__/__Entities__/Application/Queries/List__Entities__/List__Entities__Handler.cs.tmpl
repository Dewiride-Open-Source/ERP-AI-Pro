using Dewiride.Erp.BuildingBlocks.Application.Queries;
using Dewiride.Erp.BuildingBlocks.Application.Queries.Filtering;
using Dewiride.Erp.BuildingBlocks.Application.Queries.Paging;
using Dewiride.Erp.BuildingBlocks.Application.Queries.Sorting;
using Dewiride.Erp.BuildingBlocks.Kernel.Results;
using Dewiride.Erp.BuildingBlocks.Persistence.Queries;
using Dewiride.Erp.Modules.__Domain__.__Module__.__Entities__.Domain;
using Dewiride.Erp.Modules.__Domain__.__Module__.Persistence;
using Microsoft.EntityFrameworkCore;

namespace Dewiride.Erp.Modules.__Domain__.__Module__.__Entities__.Application.Queries.List__Entities__;

internal sealed class List__Entities__Handler(__Module__DbContext context) : IQueryHandler<List__Entities__Query, PagedResult<__Entity__Details>>
{
    private static readonly SortableFields<__Entity__> Sortable = new SortableFields<__Entity__>()
        .Add("name", e => e.Name);

    private static readonly FilterableFields<__Entity__> Filterable = new FilterableFields<__Entity__>()
        .Add("name", e => e.Name);

    private static readonly SortRequest ByName = new([new SortTerm("name", SortDirection.Ascending)]);

    public async Task<Result<PagedResult<__Entity__Details>>> HandleAsync(List__Entities__Query query, CancellationToken cancellationToken)
    {
        ArgumentNullException.ThrowIfNull(query);

        var sort = (query.Request.Sort.Terms.Count == 0 ? ByName : query.Request.Sort).Resolve(Sortable);
        if (sort.IsFailure)
        {
            return sort.Error!;
        }

        var filter = query.Request.Filter.Resolve(Filterable);
        if (filter.IsFailure)
        {
            return filter.Error!;
        }

        var page = await context.__Entities__
            .AsNoTracking()
            .ApplyFilter(filter.Value)
            .ApplySort(sort.Value, e => e.Id)
            .ToPagedResultAsync(query.Request.Page, cancellationToken)
            .ConfigureAwait(false);

        return page.Map(__Entity__Details.From);
    }
}
