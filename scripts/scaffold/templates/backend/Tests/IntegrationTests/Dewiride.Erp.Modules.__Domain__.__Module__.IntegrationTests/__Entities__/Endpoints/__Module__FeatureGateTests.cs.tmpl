using System.Net;
using Dewiride.Erp.Testing;
using Dewiride.Erp.Testing.Authentication;

namespace Dewiride.Erp.Modules.__Domain__.__Module__.IntegrationTests.__Entities__.Endpoints;

public sealed class __Module__FeatureGateTests(__Module__FeatureGateTests.Fixture fixture) : IClassFixture<__Module__FeatureGateTests.Fixture>
{
    private const string FeatureDisabled = "feature.disabled";

    [Theory]
    [InlineData("GET", "")]
    [InlineData("GET", "/{id}")]
    [InlineData("POST", "")]
    public async Task Request_ModuleDisabled_AnswersFeatureDisabled(string method, string suffix)
    {
        using var client = fixture.Factory.CreateClient().AsUser(TestUsers.Administrator);
        using var request = new HttpRequestMessage(new HttpMethod(method), __Entities__Api.Path(suffix.Replace("{id}", Guid.CreateVersion7().ToString(), StringComparison.Ordinal)));

        using var response = await client.SendAsync(request, TestContext.Current.CancellationToken);

        var problem = await __Entities__Api.AssertProblemAsync(response, HttpStatusCode.NotFound, FeatureDisabled);
        Assert.Contains(__Module__Module.FeatureFlag, problem.Detail, StringComparison.Ordinal);
    }

    public sealed class Fixture : IAsyncDisposable
    {
        public ErpApiFactory Factory { get; } = new ErpApiFactory().WithFeature(__Module__Module.FeatureFlag, enabled: false);

        public ValueTask DisposeAsync() => Factory.DisposeAsync();
    }
}
