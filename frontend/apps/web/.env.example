# Server-side base URL of the .NET API; the browser always talks to this web origin under /api.
API_INTERNAL_URL=http://localhost:5080

# Display name shown in the shell and the browser title.
NEXT_PUBLIC_APP_NAME=ERP-AI-Pro

# OpenTelemetry export is off unless an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=erp-ai-pro-web
