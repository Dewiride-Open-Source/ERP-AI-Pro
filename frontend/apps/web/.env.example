# Every variable is validated by src/shared/config/env.schema.ts when the server starts (next start, the
# standalone server and next dev); an invalid value stops the server with a message naming the variable.

# Origin of the .NET API (scheme://host[:port]; no path, query, fragment or credentials); the browser always talks
# to this web origin under /api. Required when NODE_ENV=production; defaults to http://localhost:5080 in development.
API_INTERNAL_URL=http://localhost:5080

# Display name shown in the shell and the browser title (1-60 characters, default ERP-AI-Pro). Inlined at build
# time: next build reads it, and the container image takes it as the build argument NEXT_PUBLIC_APP_NAME.
NEXT_PUBLIC_APP_NAME=ERP-AI-Pro

# OpenTelemetry export is off unless an OTLP/HTTP base URL is set (a path prefix is allowed, credentials are not);
# the protocol is http/protobuf (default) or http/json and the service name defaults to erp-ai-pro-web.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=erp-ai-pro-web
