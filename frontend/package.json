{
  "name": "@dewiride/erp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm build:api-client && pnpm --filter @dewiride/erp-web dev",
    "build": "pnpm --filter @dewiride/erp-web... build",
    "build:api-client": "pnpm --filter @dewiride/erp-api-client build",
    "start": "pnpm --filter @dewiride/erp-web start",
    "lint": "pnpm build:api-client && pnpm -r --parallel lint",
    "typecheck": "pnpm build:api-client && pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @dewiride/erp-e2e test",
    "e2e:install": "pnpm --filter @dewiride/erp-e2e exec playwright install --with-deps",
    "test:unit": "pnpm --filter @dewiride/erp-web test:unit"
  },
  "devDependencies": {
    "@dewiride/erp-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
